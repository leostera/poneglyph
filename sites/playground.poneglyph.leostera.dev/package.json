{
  "name": "@poneglyph/site-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev --persist-to .artifacts/dev",
    "dev:seed": "cf dev --mode seed --persist-to .artifacts/operator",
    "import:prepare": "node --import tsx scripts/prepare-import.ts",
    "import:prepare:remainder": "node --import tsx scripts/prepare-import.ts remainder90",
    "import:audit": "node --import tsx scripts/audit-import.ts",
    "import:audit:remainder": "node --import tsx scripts/audit-import.ts remainder90",
    "import:run": "node --import tsx scripts/run-import.ts",
    "import:run:remainder": "node --import tsx scripts/run-import.ts remainder90",
    "import:reconcile": "node --import tsx scripts/reconcile-import.ts",
    "import:reconcile:remainder": "node --import tsx scripts/reconcile-import.ts remainder90",
    "build": "bun run typecheck && cf build",
    "deploy": "bun run --cwd ../.. build:package && bun run --cwd ../../packages/poneglyph-worker deploy && bun run typecheck && cf deploy",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "benchmark:query-rubric": "node --import tsx scripts/run-query-rubric.ts",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@leostera/poneglyph": "workspace:*",
    "@leostera/poneglyph-mcp": "workspace:*",
    "@leostera/poneglyph-worker": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@types/node": "25.6.0",
    "cf": "1.0.0-beta.14",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
