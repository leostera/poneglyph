{
  "name": "@poneglyph/site-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev --persist-to .artifacts/dev",
    "dev:database": "cf dev --mode database --persist-to .artifacts/dev",
    "dev:seed": "cf dev --mode seed --persist-to .artifacts/operator",
    "build": "bun run typecheck && cf build --mode database && cf build",
    "deploy": "bun run deploy:database && cf deploy",
    "deploy:database": "bun run --cwd ../.. build:package && bun run typecheck && cf deploy --mode database",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@leostera/poneglyph": "workspace:*",
    "@leostera/poneglyph-mcp": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@types/node": "25.6.0",
    "cf": "1.0.0-beta.14",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
