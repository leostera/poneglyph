{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poneglyph-cloudflare-prototype",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "GRAPH_COORDINATORS", "class_name": "GraphCoordinatorDO" },
      { "name": "GRAPH_SHARDS", "class_name": "GraphShardDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GraphCoordinatorDO", "GraphShardDO"]
    }
  ]
}
