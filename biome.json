{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "ignore": [
      ".husky/_",
      "3rdparty",
      "design",
      "www/.astro",
      "app/dist",
      "app/.vite",
      "app/src/components/ui",
      "app/src/lib/graphql/generated",
      "app/src/routeTree.gen.ts",
      "packages/ui/storybook-static",
      "target",
      "dist",
      "node_modules"
    ]
  }
}
