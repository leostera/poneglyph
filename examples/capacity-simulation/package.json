{
  "name": "@poneglyph/example-capacity-simulation",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun run --cwd ../.. vitest run --config vitest.config.ts --project=node examples/capacity-simulation/test",
    "check": "bun run typecheck && bun run test",
    "run": "node --import tsx src/main.ts"
  },
  "dependencies": {"@leostera/poneglyph": "workspace:*"},
  "devDependencies": {"@types/node": "25.6.0", "esbuild": "0.28.2", "tsx": "4.23.15", "typescript": "5.9.3"}
}
