{
  "name": "poneglyph-desktop",
  "private": true,
  "version": "0.1.0",
  "author": "Poneglyph",
  "description": "Poneglyph desktop app",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build:bundle": "electron-vite build",
    "build:app": "electron-builder --mac dir --config electron-builder.yml",
    "build": "bun run build:bundle && bun run build:app",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@poneglyph/i18n": "workspace:*",
    "@poneglyph/ui": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "vite": "^7.1.3"
  }
}
