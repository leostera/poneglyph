#!/usr/bin/env sh
set -eu

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED_FILES" ]; then
  echo "pre-commit: no staged files"
  exit 0
fi

is_rust_change() {
  echo "$STAGED_FILES" | grep -Eq '^(crates/|Cargo\.toml|Cargo\.lock|\.cargo/)'
}

is_web_change() {
  echo "$STAGED_FILES" | grep -Eq '^(app/|packages/|www/|package\.json|bun\.lock|bunfig\.toml|biome\.json|commitlint\.config\.(mjs|cjs|js)|vite\.config\.(ts|js)|tsconfig(\..+)?\.json)'
}

has_rust_workspace() {
  cargo metadata --no-deps --format-version=1 2>/dev/null | grep -q '"workspace_members":\[[^]]'
}

restage_tracked_changes() {
  echo "$STAGED_FILES" | while IFS= read -r file; do
    if [ -n "$file" ] && [ -e "$file" ]; then
      git add -- "$file"
    fi
  done
}

run_biome_on_staged() {
  biome_command="$1"
  shift

  set --
  echo "$STAGED_FILES" | while IFS= read -r file; do
    case "$file" in
      app/*|packages/*|www/*|package.json|bun.lock|bunfig.toml|biome.json|commitlint.config.mjs|commitlint.config.cjs|commitlint.config.js|vite.config.ts|vite.config.js|tsconfig.json|tsconfig.*.json)
        if [ -e "$file" ]; then
          printf '%s\0' "$file"
        fi
        ;;
    esac
  done | xargs -0 ./node_modules/.bin/biome "$biome_command" "$@"
}

if is_rust_change; then
  if has_rust_workspace; then
    echo "pre-commit: running Rust checks"
    cargo fix --workspace --allow-dirty --allow-staged
    cargo fmt --all
    restage_tracked_changes
    cargo check
    cargo nextest run --workspace --lib --tests --bins -E 'not test(/e2e/) and not test(/_long$/)'
  else
    echo "pre-commit: skipping Rust checks (no valid Cargo workspace yet)"
  fi
fi

if is_web_change; then
  echo "pre-commit: running web checks"
  run_biome_on_staged format --write
  restage_tracked_changes
  run_biome_on_staged check --diagnostic-level=error
  bun run typecheck:fast
fi
