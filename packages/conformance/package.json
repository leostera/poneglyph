{
  "name": "@poneglyph/conformance-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:oracle": "node --import tsx --test --test-concurrency=1 *.test.ts",
    "test:small": "bun run test:oracle && node --import tsx run.ts",
    "test:focused": "bun run test:oracle && node --import tsx run-focused.ts"
  },
  "dependencies": {"@leostera/poneglyph": "workspace:*"},
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@types/node": "25.6.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
