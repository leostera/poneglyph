{
  "name": "@poneglyph/write-path-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import tsx build.ts",
    "prepare:corpus": "node --import tsx corpus.ts",
    "prepare:enrichment": "node --import tsx prepare-enrichment.ts",
    "preflight": "node --import tsx preflight.ts",
    "test": "bun run --cwd ../.. vitest run --config vitest.config.ts --project=node packages/write-path-bench/tests",
    "typecheck": "tsc --noEmit",
    "run:local": "node --import tsx run.ts"
  },
  "dependencies": {
    "@leostera/poneglyph": "workspace:*",
    "@cloudflare/workers-types": "5.20261011.1",
    "@types/node": "25.6.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "saxes": "6.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
