{
  "compilerOptions": {
    "target": "es2024", "lib": ["es2024", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "module": "preserve", "moduleResolution": "bundler", "types": ["node"],
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "isolatedModules": true, "verbatimModuleSyntax": true, "skipLibCheck": true
  },
  "include": ["src", "test", "bench", "cloudflare.config.ts", ".cloudflare/types"]
}
