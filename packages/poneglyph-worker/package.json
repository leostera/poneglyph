{
  "name": "@leostera/poneglyph-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private graph-scoped Workers RPC assembly of canonical Poneglyph storage.",
  "exports": { ".": "./src/index.ts", "./config": "./cloudflare.config.ts" },
  "scripts": {
    "dev": "cf dev --persist-to .artifacts/dev",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "bun run --cwd ../.. vitest run --config vitest.config.ts --project=node packages/poneglyph-worker/test",
    "bench:local-tenant-graphs": "node --import tsx bench/local-tenant-graphs.ts",
    "bench:local-partition-counts": "node --import tsx bench/local-partition-counts.ts",
    "bench:local-point-owner": "node --import tsx bench/local-point-owner.ts",
    "bench:local-point-owner-scale": "node --import tsx bench/local-point-owner-scale.ts",
    "bench:local-point-buckets": "node --import tsx bench/local-point-buckets.ts",
    "bench:local-point-bucket-scale": "node --import tsx bench/local-point-bucket-scale.ts",
    "bench:local-point-bucket-load": "node --import tsx bench/local-point-bucket-load.ts",
    "bench:local-point-bucket-large": "node --import tsx bench/local-point-bucket-large.ts",
    "check": "bun run typecheck && bun run test",
    "build": "bun run typecheck && cf build",
    "deploy": "bun run --cwd ../.. build:package && bun run typecheck && cf deploy"
  },
  "dependencies": { "@leostera/poneglyph": "workspace:*" },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@types/node": "25.6.0",
    "cf": "1.0.0-beta.14",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
