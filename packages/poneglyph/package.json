{
  "name": "@leostera/poneglyph",
  "version": "0.1.0",
  "description": "Typed facts, bounded Datalog, and an HTTP client for the Poneglyph graph database prototype.",
  "keywords": [
    "semantic-graph",
    "graph-database",
    "datalog",
    "cloudflare-workers",
    "durable-objects",
    "typescript"
  ],
  "homepage": "https://github.com/leostera/poneglyph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leostera/poneglyph.git",
    "directory": "packages/poneglyph"
  },
  "bugs": {
    "url": "https://github.com/leostera/poneglyph/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "cf dev",
    "typecheck": "tsc --noEmit",
    "build:package": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "bun run build:package",
    "prepublishOnly": "bun run check",
    "test": "vitest run --bail 1",
    "check": "bun run workers:types && bun run typecheck && bun run test",
    "build": "bun run workers:types && bun run typecheck && cf build",
    "deploy": "bun run workers:types && bun run typecheck && cf deploy",
    "workers:types": "cf workers types",
    "example:client": "tsx ../../examples/client-quickstart.ts",
    "test:capacity": "tsx ../../examples/capacity-simulation.ts",
    "test:onepiece": "tsx ../../examples/onepiece-load.ts",
    "bench:local": "PONEGLYPH_RUN_BENCH=1 vitest run tests/throughput-bench.test.ts --reporter=verbose",
    "bench:cloudflare": "tsx ../../examples/deployed-benchmark.ts",
    "test:deployed": "tsx ../../examples/deployed-smoke.ts",
    "test:deployed:todo": "tsx ../../examples/deployed-todo-smoke.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/node": "25.6.0",
    "cf": "1.0.0-beta.14",
    "saxes": "6.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.7",
    "ws": "8.21.0"
  }
}
