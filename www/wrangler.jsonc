{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poneglyph-www",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,
  "routes": [
    {
      "pattern": "poneglyph.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
