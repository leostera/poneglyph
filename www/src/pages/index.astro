---
import { PoneglyphLogo3D } from "@poneglyph/ui";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Poneglyph";
const description =
  "Better memory for agents. Private, fast, absolute memory for builders and their AI agents.";

const quickstart = `npx -g i poneglyph

# connect OpenClaw or another agent
# write facts
# recall project knowledge later`;

const featureHighlights = [
  {
    title: "Built for builders",
    body: "Poneglyph is designed for teams building with agents, where project knowledge and prior decisions need to survive beyond a single session.",
  },
  {
    title: "Private by default",
    body: "Memory stays local to your machine, which keeps recall fast and keeps sensitive context out of a hosted black box.",
  },
  {
    title: "Structured to scale",
    body: "Facts, entities, and relationships beat markdown folders once your projects, systems, packages, and people become deeply connected.",
  },
];

const sections = [
  {
    eyebrow: "Absolute memory",
    title: "Your agents stop forgetting the shape of your projects.",
    body: "Poneglyph gives agents durable memory across sessions, projects, and time. Less repetition, less context loss, less restating architecture by hand.",
  },
  {
    eyebrow: "Existing agent stack",
    title: "Works with the tools you already use.",
    body: "Start with OpenClaw out of the box. Extend the same memory layer to Codex, Claude-based agents, and other MCP clients.",
  },
  {
    eyebrow: "Project knowledge",
    title: "A memory model built for systems, packages, and decisions.",
    body: "Poneglyph models concepts, systems, packages, people, and project knowledge directly, so builders can recover how a project fits together.",
  },
];

const comparisonRows = [
  {
    without:
      "Your agent forgets project decisions, package boundaries, and prior work between sessions.",
    with: "Poneglyph gives it durable recall across time, so project context compounds instead of resetting.",
  },
  {
    without:
      "You keep restating the same architecture, constraints, and preferences every time an agent wakes up.",
    with: "Poneglyph turns repeated explanation into accumulated memory your agent can recover later.",
  },
  {
    without:
      "Team knowledge lives in notes, logs, issues, and chat fragments that never form one coherent memory.",
    with: "Poneglyph links project knowledge into a graph your agents can query instead of guess at.",
  },
];

const objections = [
  {
    eyebrow: "Why not markdown",
    title: "Markdown memory is elegant until it stops scaling.",
    body: "Files are simple, but project memory eventually becomes deeply connected. Systems refer to packages, packages refer to concepts, decisions refer to tradeoffs, and agents need more than a folder tree to recover that shape reliably.",
  },
  {
    eyebrow: "Why not SQL",
    title: "SQL stores records well. Memory is a different problem.",
    body: "Application tables are optimized around current state. Agent memory needs durable history, provenance, relationships, and replayable derived views. That is why Poneglyph uses an immutable graph model under the hood.",
  },
];

const architecture = [
  "Atomic fact writes with ordered transaction IDs",
  "Strongly consistent reads over facts after commit",
  "Asynchronous consolidation into emergent entities",
  "Projection workers for search and other read models",
  "Local service surfaces for agents and operator tooling",
];
---

<BaseLayout title={title} description={description}>
  <main class="page-shell">
    <header class="topbar">
      <div class="brand-lockup">
        <div aria-hidden="true" class="brand-mark-shell logo-shell">
          <PoneglyphLogo3D client:load className="brand-mark-3d" size={50} />
        </div>
        <a class="brand" href="/">
          <span>Poneglyph</span>
        </a>
      </div>
      <nav class="nav-links">
        <a href="#quickstart">Quickstart</a>
        <a href="#features">Features</a>
        <a href="#changes">Changes</a>
        <a class="nav-button" href="https://github.com/leostera/poneglyph">GitHub</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Better memory for agents</p>
        <h1>Private, fast, absolute memory for your AI agents.</h1>
        <p class="lede">
          Poneglyph gives builders a memory layer for existing agents that stays
          local, recalls fast, and scales beyond markdown files and ad hoc note
          stores.
        </p>
        <p class="lede">
          Works out of the box with OpenClaw, and is designed to become the
          memory layer for the rest of your agent stack too.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#quickstart">Install Poneglyph</a>
          <a class="button button-secondary" href="https://github.com/leostera/poneglyph">
            GitHub
          </a>
        </div>
      </div>

      <div class="hero-preview">
        <div class="preview-shell">
          <div class="preview-header">
            <span>Poneglyph</span>
            <span>Agent memory</span>
          </div>
          <div class="preview-body">
            <div class="preview-stage" aria-hidden="true">
              <PoneglyphLogo3D client:load className="preview-logo" size={220} />
            </div>
            <div class="preview-block">
              <p class="preview-label">Project knowledge</p>
              <p>Runtime is Rust. UI is Astro. Memory is shared between OpenClaw, Codex, and local tools.</p>
            </div>
            <div class="preview-block">
              <p class="preview-label">Linked context</p>
              <p>Packages, systems, concepts, and prior decisions stay connected instead of disappearing into notes.</p>
            </div>
            <div class="preview-block code">
              <pre><code>{quickstart}</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="highlights" id="features">
      {featureHighlights.map((item) => (
        <article class="highlight">
          <p class="highlight-title">{item.title}</p>
          <p>{item.body}</p>
        </article>
      ))}
    </section>

    <section class="split-section" id="quickstart">
      <div class="section-copy">
        <p class="eyebrow">Quickstart</p>
        <h2>From zero to agent memory in a few commands.</h2>
        <p>
          Open source. Local-first. Start with OpenClaw or another agent and
          begin building project memory immediately. No hosted account required.
        </p>
        <div class="inline-links">
          <a href="https://github.com/leostera/poneglyph">Install from GitHub</a>
          <a href="https://github.com/leostera/poneglyph/tree/main/docs/rfds">Read the architecture</a>
        </div>
      </div>
      <div class="code-panel">
        <pre><code>{quickstart}</code></pre>
      </div>
    </section>

    {sections.map((section) => (
      <section class="split-section editorial">
        <div class="section-copy">
          <p class="eyebrow">{section.eyebrow}</p>
          <h2>{section.title}</h2>
        </div>
        <div class="section-body">
          <p>{section.body}</p>
        </div>
      </section>
    ))}

    {objections.map((section) => (
      <section class="split-section editorial">
        <div class="section-copy">
          <p class="eyebrow">{section.eyebrow}</p>
          <h2>{section.title}</h2>
        </div>
        <div class="section-body">
          <p>{section.body}</p>
        </div>
      </section>
    ))}

    <section class="comparison-section" id="changes">
      <div class="section-copy comparison-heading">
        <p class="eyebrow">What changes</p>
        <h2>Without Poneglyph. With Poneglyph.</h2>
      </div>
      <div class="comparison-table">
        {comparisonRows.map((row) => (
          <article class="comparison-row">
            <div>
              <p class="comparison-label">Without</p>
              <p>{row.without}</p>
            </div>
            <div>
              <p class="comparison-label">With Poneglyph</p>
              <p>{row.with}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="split-section under-hood">
      <div class="section-copy">
        <p class="eyebrow">Under the hood</p>
        <h2>Why the model is different.</h2>
        <p>
          Poneglyph handles long-term memory with facts, entities, and
          projections so the system can stay durable, inspectable, and
          replayable as it grows.
        </p>
      </div>
      <ol class="flow-list">
        {architecture.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
    </section>

    <section class="cta">
      <div class="section-copy">
        <p class="eyebrow">Get started</p>
        <h2>Install Poneglyph and give your agents better memory.</h2>
        <p><code>npx -g i poneglyph</code></p>
      </div>
      <a class="button button-primary" href="https://github.com/leostera/poneglyph">
        Install locally
      </a>
    </section>
  </main>
</BaseLayout>
